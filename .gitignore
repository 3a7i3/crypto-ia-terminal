# Ignore log files and large data
logs/
*.log
quant-ai-system/logs/
quant-ai-system/logs/trading_system.log

# Ignore Python cache
__pycache__/
*.pyc

# Ignore Jupyter notebook checkpoints
.ipynb_checkpoints/

# Ignore environment and setup files
.env
.env.*
*.env
venv/
.venv/
setup/

# Ignore API secrets and credentials
secrets.json
secrets.yaml
secrets.yml
*_secret*
*_key*
*_credentials*
api_keys.json

# Ignore OS files
.DS_Store
Thumbs.db

# Ignore data files
data/
*.csv

# Ignore backups and archives
*.broken_backup
*.tar.gz
*.zip
.coverage
archives/

# Ignore SQLite databases et bases de données runtime
*.sqlite
*.db
databases/
*.jsonl

# EXCEPTION — le ledger scientifique (couche L1) DOIT être versionné.
# KNOWLEDGE_MODEL §3.1 : c'est la seule chose non reconstructible du système ;
# la connaissance, les verdicts et le graphe se redérivent, un événement perdu
# est perdu. La règle *.jsoni ci-dessus l'excluait silencieusement — les
# 7 premières observations n'ont jamais été commitées.
# PM-7 exige à terme une réplication hors dépôt ; tant qu'elle n'existe pas,
# git est la seule réplication disponible, et un ledger non répliqué est pire.
!knowledge/*.jsonl

# Ignore temporary files
*.tmp
*.temp
~$*
*.swp
*.bak

# Ignore runtime / generated artifacts
cache/
*.pkl
.portfolio_bot_started
PROJET_MINIATURE.md
PROJET_MINIATURE_FULL.md

# Exports du corpus VPS (archives lourdes, jamais versionnées — le dépôt
# n'est pas un magasin de données ; databases/ est déjà exclu plus haut).
backups/

# Ignore frontend build artifacts
node_modules/
frontend/node_modules/
frontend/dist/
frontend/build/
dist/
build/
