# ═══════════════════════════════════════════════════════════════════════════
#  .env.secrets.example — SEULS les secrets (tokens, API keys, mots de passe)
# ═══════════════════════════════════════════════════════════════════════════
#
# Ce fichier est un TEMPLATE. Ne le renseignez pas ici — ces valeurs vont dans
# le vrai `.env` du VPS (chargé par les units systemd via EnvironmentFile=).
#
# Étapes de reprise après révocation des 8 bots Telegram (2026-08-27) :
#   1. Récupérer chaque token via BotFather : /mybots → <bot> → API Token
#   2. Coller le token dans la ligne correspondante ci-dessous
#   3. Copier ce bloc entier dans ~/.env (VPS) — écrase les vieilles lignes
#      correspondantes SEULEMENT, ne touche PAS aux flags non-secrets
#      (FEATURE_*, PAPER_TRADING_ENABLED, RESTART_DISABLED_*, DP_LOG_DIR, etc.)
#   4. `sudo systemctl restart crypto-advisor crypto-quant-observer \
#          crypto-radar-bot crypto-watchdog paper-arena`
#   5. Vérifier avec le script `whoami` (getMe sur chaque token) que chaque
#      variable pointe bien vers le bot indiqué en commentaire.
#
# Règles invariantes :
#   • Ne jamais commiter le vrai `.env` (déjà dans .gitignore — vérifier).
#   • Le code ne lit QUE les valeurs à droite de `=`. Les commentaires (#) sont
#     documentaires : les mettre à jour à chaque rebrancher, jamais mentir.
#   • Un token = un bot = un rôle. Deux processus qui polling (getUpdates) le
#     même token = conflit HTTP 409 (cf incident portfolio_bot.py archivé).
#     Deux processus qui n'envoient que sendMessage sur le même token = OK.
#
# ═══════════════════════════════════════════════════════════════════════════
#  TELEGRAM — 8 bots BotFather, 7 rôles côté code (@Telemetrie_IA_bot retiré)
# ═══════════════════════════════════════════════════════════════════════════

# ─── Bot 1/8 : @RadarCrypto1_bot ("CryptoRadar_Bot") ───────────────────────
# Rôle CODE  : canal MOTEUR + radar interactif (deux processus, même token).
#              Émet : guide de lecture, [ALIVE] heartbeat, MEXC SIM cards,
#              WATCHDOG MOTEUR MORT, Kill Switch, alertes marché.
#              Reçoit : slash commands /scan /signals /top50 /longs /shorts
#              /symbol /status /lmi /help (scripts/radar_bot.py).
# Processus  : core/advisor_loop.py + watchdog_vps.py + scripts/radar_bot.py
# BEHAVIOR   : sous-canal du même bot mais chat différent (groupe -100…).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_BEHAVIOR_CHAT_ID=

# ─── Bot 2/8 : @Telemetrie_IA_bot ("Télémétrie") ───────────────────────────
# Rôle CODE  : AUCUN dans main. Module observability/narrator SUPPRIMÉ du
#              disque, process PID 504 vit en mémoire depuis Aug 24 (zombie
#              DS-002 v2). À tuer proprement — ne PAS renseigner de token
#              ici tant que le code n'est pas restauré ou l'ADR "narrateur
#              retiré" signé.
# Si vous voulez le réactiver plus tard : documenter dans ADR, restaurer le
# code depuis git (b68c803, 05d523b), redéployer, PUIS remplir ci-dessous.
#NARRATOR_BOT_TOKEN=
#NARRATOR_CHAT_ID=

# ─── Bot 3/8 : @rapport_automatique_bot ("Rapport Automatique") ────────────
# Rôle CODE  : diagnostic complet toutes les 6h en langage naturel
#              (quant_hedge_ai/agents/intelligence/system_intel_reporter.py).
#              Envoi uniquement, pas de polling.
# Processus  : core/advisor_loop.py::_send_intel (in-process moteur)
RAPPORT_AUTOMATIQUE_BOT_TOKEN=   # was: INTEL_BOT_TOKEN
RAPPORT_AUTOMATIQUE_CHAT_ID=     # was: INTEL_BOT_CHAT_ID

# ─── Bot 4/8 : @PaperArena_bot ("PaperArena") ──────────────────────────────
# Rôle CODE  : notifications trades PaperArena (src/paper/paper_report.py).
#              Émet PAPER ENTRY, PAPER EXIT, RÉSUMÉ. Format DIFFÉRENT des
#              cartes MEXC SIM du moteur — c'est une stratégie indépendante
#              (RSIExtremeStrategy 4h, paper_runner.py).
# Processus  : src/paper/paper_runner.py (paper-arena.service)
# NB : silence actuel (Aug 27) ≠ problème de token → gate/stratégie à auditer.
PAPER_ARENA_BOT_TOKEN=           # was: PAPER_ARENA_TG_TOKEN
PAPER_ARENA_CHAT_ID=             # was: PAPER_ARENA_TG_CHAT_ID

# ─── Bot 5/6 : @mon_portfolio_bot ("Mon Portefeuille Bot") ─────────────────
# Rôle CODE  : Portfolio CommandCenter — rapports périodiques portefeuille +
#              POLLING getUpdates pour commandes read-only.
#              Reçoit aussi les notifications de statut compte réel
#              (STANDBY/LIVE, solde API) via core/advisor_loop.py::_telegram_real().
#
#              ⚠️  UN SEUL poller autorisé par token. Le CommandCenter poll
#              déjà — ne JAMAIS relancer src/telegram/portfolio_bot.py
#              (archivé, cf _ARCHIVE_2026/telegram_bot_duplicates_20260706/).
#
# REAL_ACCOUNT_BOT_TOKEN supprimé — fusionné avec MON_PORTFOLIO_BOT_TOKEN
# (merge 2026-08-28 : c'était le même token physique, deux variables distinctes
#  sans justification architecturale — cf ADR TELEGRAM_IDENTITY_REGISTRY.md).
MON_PORTFOLIO_BOT_TOKEN=         # was: P10_PORTFOLIO_BOT_TOKEN
MON_PORTFOLIO_CHAT_ID=           # was: P10_PORTFOLIO_CHAT_ID

# ─── Bot 6/8 : @Connexion_VScode_bot ("Connexion_Systeme_VScode") ──────────
# Rôle CODE  : hors trading — probablement usage manuel (SSH/relais VSCode).
# Aucune variable env attendue par le code de trading.

# ─── Bot 7/8 : @QuantCrpto_bot ("Crypto_ia_quant") ─────────────────────────
# Rôle CODE  : observer passif (ADR-0007) — message ÉPINGLÉ mis à jour toutes
#              les QC_PINNED_UPDATE secondes + slash commands /snapshot /health
#              /pipeline /portfolio.
# Processus  : src/telegram/quant_observer/bot.py (crypto-quant-observer.service)
# QC_PINNED_MSG_ID : ID du message épinglé — obtenu via BOOTSTRAP UNE FOIS :
#   .venv/bin/python scripts/quant_observer_pin_bootstrap.py
# après avoir renseigné TOKEN + CHAT_ID. Coller l'ID retourné ci-dessous.
QUANT_CRYPTO_BOT_TOKEN=          # was: QC_BOT_TOKEN
QUANT_CRYPTO_CHAT_ID=            # was: QC_CHAT_ID
QC_PINNED_MSG_ID=
#QC_POLL_INTERVAL=2       # optionnel (défaut 2s)
#QC_PINNED_UPDATE=600     # optionnel (défaut 600s = 10 min)

# ─── Bot 8/8 : @FtnTrading_bot ("SimBot") ──────────────────────────────────
# Rôle CODE  : bot dédié simulation manuelle (src/telegram/sim_bot.py +
#              src/telegram/bot_runner.py). AUCUN service systemd committé —
#              lancement manuel : `python -m src.telegram.bot_runner`.
# Si vous ne l'utilisez pas actuellement, laisser vide (le module refuse
# de démarrer sans token → aucun effet de bord).
TELEMETRIE_IA_BOT_TOKEN=         # was: CMVK_BOT_TOKEN
TELEMETRIE_IA_CHAT_ID=           # was: CMVK_CHAT_ID

# ═══════════════════════════════════════════════════════════════════════════
#  EXCHANGE API — clés lecture/écriture (crée en read-only + IP whitelist VPS)
# ═══════════════════════════════════════════════════════════════════════════
#
# En mode PAPER (PAPER_TRADING_ENABLED=true, défaut) : les clés sont utilisées
# UNIQUEMENT en LECTURE (soldes réels, prix live). Aucun ordre réel n'est
# envoyé, quel que soit l'état des clés — voir SEC-01 (ExecutionEngine).
#
# Recommandation Canada : Kraken (conformité) > Gate.io > Binance.
# MEXC reste supporté pour la simulation (MexcSimulator + MEXC_API_KEY côté
# lecture wallet — pas d'ordre passé sur MEXC).

# --- Kraken ---
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# --- Gate.io ---
GATEIO_API_KEY=
GATEIO_API_SECRET=

# --- Binance ---
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- MEXC (lecture wallet réel pour WalletSync ; simulation d'ordres) ---
MEXC_API_KEY=
MEXC_API_SECRET=

# ═══════════════════════════════════════════════════════════════════════════
#  EMAIL SMTP — notifications de secours (exchange_monitor, alertes lentes)
# ═══════════════════════════════════════════════════════════════════════════
#
# Utilisé si Telegram échoue (rate-limit, panne). Optionnel.
# Voir supervision/exchange_monitor.py.

EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_FROM_ADDR=
EMAIL_SMTP_PASS=
EMAIL_TO_ADDR=

# ═══════════════════════════════════════════════════════════════════════════
#  INTÉGRATIONS EXTERNES (optionnelles)
# ═══════════════════════════════════════════════════════════════════════════

#SLACK_WEBHOOK_URL=

# ═══════════════════════════════════════════════════════════════════════════
#  Rappel — CE FICHIER NE CONTIENT QUE DES SECRETS
# ═══════════════════════════════════════════════════════════════════════════
#
# Les flags de configuration (FEATURE_*, PAPER_TRADING_ENABLED,
# LIVE_TRADING_CONFIRMED, RESTART_DISABLED_UNTIL_RECONCILIATION,
# V9_*, EXEC_*, EXCHANGE_ID, DP_LOG_DIR, SIGNAL_MIN_SCORE, etc.) sont
# des paramètres NON-secrets. Ils vivent aussi dans `.env` mais dans une
# section séparée — voir .env.example pour la liste complète, ou
# CONFIG_REFERENCE_V91.md pour la documentation exhaustive.
