[Unit]
Description=CryptoRadar Web Dashboard
After=network-online.target

[Service]
Type=simple
User=mathieu
WorkingDirectory=/home/mathieu/crypto_ai_terminal
EnvironmentFile=/home/mathieu/crypto_ai_terminal/.env
# SEC-API-01: dashboard auth is isolated from exchange and Telegram secrets.
# Mandatory fragment: missing provisioning fails service startup instead of
# silently running without DASHBOARD_PASSWORD.
EnvironmentFile=/etc/crypto-ai/secrets/dashboard.env
ExecStart=/home/mathieu/crypto_ai_terminal/.venv/bin/python scripts/dashboard_api.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
