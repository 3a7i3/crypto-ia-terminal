# Copie de reference de l'unite VPS (watchdog, alerte seule) - capturee le 2026-07-16
# pour le runbook de restauration (docs/runbook-restauration-vps.md).
# SEC-API-01 : le watchdog peut conserver ses secrets d'alerte Telegram, mais
# aucune credential d'exchange n'est necessaire a la supervision de process.
[Unit]
Description=Crypto AI Terminal — Watchdog (surveillance moteur, alerte seule)
After=network-online.target crypto-advisor.service
Wants=network-online.target

[Service]
Type=simple
User=mathieu
WorkingDirectory=/home/mathieu/crypto_ai_terminal
EnvironmentFile=-/home/mathieu/crypto_ai_terminal/.env
EnvironmentFile=-/home/mathieu/crypto_ai_terminal/.env.secrets
UnsetEnvironment=MEXC_API_KEY MEXC_API_SECRET MEXC_SECRET_KEY BINANCE_API_KEY BINANCE_API_SECRET BINANCE_LIVE_API_KEY BINANCE_LIVE_API_SECRET BINANCE_FUTURES_DEMO_KEY BINANCE_FUTURES_DEMO_SECRET BINANCE_SECRET KRAKEN_API_KEY KRAKEN_API_SECRET GATEIO_API_KEY GATEIO_API_SECRET BYBIT_API_KEY BYBIT_API_SECRET OKX_API_KEY OKX_API_SECRET OKX_PASSWORD LIVE_READER_API_KEY LIVE_READER_API_SECRET
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONIOENCODING=utf-8
Environment=TZ=UTC
ExecStart=/home/mathieu/crypto_ai_terminal/.venv/bin/python3 watchdog_vps.py
Restart=on-failure
RestartSec=15s
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=crypto_watchdog
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
