# Crypto AI Terminal — Watchdog (surveillance moteur, alerte seule).
# SEC-API-01 — least-privilege alert identity.
#
# Public/non-secret configuration:
#   /home/mathieu/crypto_ai_terminal/.env
#
# Required runtime-only secret fragment (HUMAN_ONLY, never committed):
#   /etc/crypto-ai/secrets/watchdog.env
# containing only:
#   TELEGRAM_BOT_TOKEN
#   TELEGRAM_CHAT_ID
[Unit]
Description=Crypto AI Terminal — Watchdog (surveillance moteur, alerte seule)
After=network-online.target crypto-advisor.service
Wants=network-online.target

[Service]
Type=simple
User=mathieu
WorkingDirectory=/home/mathieu/crypto_ai_terminal
EnvironmentFile=-/home/mathieu/crypto_ai_terminal/.env
EnvironmentFile=/etc/crypto-ai/secrets/watchdog.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONIOENCODING=utf-8
Environment=TZ=UTC
ExecStart=/home/mathieu/crypto_ai_terminal/.venv/bin/python3 watchdog_vps.py
Restart=on-failure
RestartSec=15s
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=crypto_watchdog
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
