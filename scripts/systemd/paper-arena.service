# Crypto AI Terminal — Paper Trade Notifier (Telegram send-only).
# TG-PAPER-01 (2026-09) : @PaperArena_bot est refondu en simple flux de
# notification PUSH-ONLY des ENTRY/EXIT paper de la main machine
# (MexcSimulator -> databases/paper_trades.jsonl -> Telegram).
# Aucune autorité de trading : ce service ne decide rien, n'ouvre/ne ferme
# aucune position, et une panne d'envoi Telegram n'a aucun effet sur le
# moteur de decision (ADR-0007, passivite des observers).
#
# Prerequis dans .env.secrets :
#   PAPER_ARENA_BOT_TOKEN=<token bot @PaperArena_bot>
#   PAPER_ARENA_CHAT_ID=<chat id destinataire>
#
# SEC-API-01 : le notifier conserve uniquement son identite Telegram utile ;
# les credentials d'exchange sont supprimees de l'environnement final.
#
# Installation (VPS, geste operateur) :
#   sudo cp scripts/systemd/paper-arena.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now paper-arena.service
#   sudo systemctl status paper-arena.service
[Unit]
Description=Crypto AI Terminal — PAPER Trade Notifier (Telegram send-only)
After=network-online.target crypto-advisor.service
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=mathieu
WorkingDirectory=/home/mathieu/crypto_ai_terminal
EnvironmentFile=-/home/mathieu/crypto_ai_terminal/.env
EnvironmentFile=-/home/mathieu/crypto_ai_terminal/.env.secrets
UnsetEnvironment=MEXC_API_KEY MEXC_API_SECRET MEXC_SECRET_KEY BINANCE_API_KEY BINANCE_API_SECRET BINANCE_LIVE_API_KEY BINANCE_LIVE_API_SECRET BINANCE_FUTURES_DEMO_KEY BINANCE_FUTURES_DEMO_SECRET BINANCE_SECRET KRAKEN_API_KEY KRAKEN_API_SECRET GATEIO_API_KEY GATEIO_API_SECRET BYBIT_API_KEY BYBIT_API_SECRET OKX_API_KEY OKX_API_SECRET OKX_PASSWORD LIVE_READER_API_KEY LIVE_READER_API_SECRET
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONIOENCODING=utf-8
Environment=TZ=UTC
Environment=PYTHONPATH=/home/mathieu/crypto_ai_terminal
ExecStart=/home/mathieu/crypto_ai_terminal/.venv/bin/python3 -m src.paper.paper_trade_notifier
Restart=on-failure
RestartSec=10s
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=paper_arena
Nice=10
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
