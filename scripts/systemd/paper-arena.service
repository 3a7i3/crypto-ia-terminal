# Paper Arena V1 — ETH/USDT 4h RSI 15/85.
# Boucle de trading paper qui envoie notifications Telegram
# (entrees, sorties, rapports) automatiquement.
# Installation (VPS, geste operateur) :
#   sudo cp scripts/systemd/paper-arena.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now paper-arena.service
[Unit]
Description=Paper Arena V1 — ETH 4h RSI 15/85
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mathieu
WorkingDirectory=/home/mathieu/crypto_ai_terminal
EnvironmentFile=/home/mathieu/crypto_ai_terminal/.env
Environment=PYTHONPATH=/home/mathieu/crypto_ai_terminal
ExecStart=/home/mathieu/crypto_ai_terminal/.venv/bin/python3 -m src.paper.paper_runner
Restart=always
RestartSec=10
StandardOutput=append:/home/mathieu/crypto_ai_terminal/logs/paper_arena.log
StandardError=append:/home/mathieu/crypto_ai_terminal/logs/paper_arena.log

[Install]
WantedBy=multi-user.target
