# Crypto AI Terminal — Paper Trade Notifier (Telegram send-only).
# SEC-API-01 — least-privilege service identity.
#
# Public/non-secret configuration:
#   /home/mathieu/crypto_ai_terminal/.env
#
# Required runtime-only secret fragment (HUMAN_ONLY, never committed):
#   /etc/crypto-ai/secrets/paper-arena.env
# containing only:
#   PAPER_ARENA_BOT_TOKEN
#   PAPER_ARENA_CHAT_ID
[Unit]
Description=Crypto AI Terminal — PAPER Trade Notifier (Telegram send-only)
After=network-online.target crypto-advisor.service
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=mathieu
WorkingDirectory=/home/mathieu/crypto_ai_terminal
EnvironmentFile=-/home/mathieu/crypto_ai_terminal/.env
EnvironmentFile=/etc/crypto-ai/secrets/paper-arena.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONIOENCODING=utf-8
Environment=TZ=UTC
Environment=PYTHONPATH=/home/mathieu/crypto_ai_terminal
ExecStart=/home/mathieu/crypto_ai_terminal/.venv/bin/python3 -m src.paper.paper_trade_notifier
Restart=on-failure
RestartSec=10s
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=paper_arena
Nice=10
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
