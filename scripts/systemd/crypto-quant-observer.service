# @QuantCrypto_bot — SDOS Visualization Client (bot Telegram passif, ADR-0007).
# SEC-API-01 — least-privilege service identity.
#
# Public/non-secret configuration:
#   /home/mathieu/crypto_ai_terminal/.env
#
# Required runtime-only secret fragment (HUMAN_ONLY, never committed):
#   /etc/crypto-ai/secrets/quant-observer.env
# containing only:
#   QUANT_CRYPTO_BOT_TOKEN
#   QUANT_CRYPTO_CHAT_ID
#   QC_PINNED_MSG_ID
#
# Mandatory EnvironmentFile: deployment must provision the fragment before
# restarting this service. No fallback to the global .env.secrets store.
[Unit]
Description=Crypto AI Terminal — @QuantCrypto_bot (SDOS observer passif, ADR-0007)
After=network-online.target crypto-advisor.service
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=mathieu
WorkingDirectory=/home/mathieu/crypto_ai_terminal
EnvironmentFile=-/home/mathieu/crypto_ai_terminal/.env
EnvironmentFile=/etc/crypto-ai/secrets/quant-observer.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONIOENCODING=utf-8
Environment=TZ=UTC
Environment=PYTHONPATH=/home/mathieu/crypto_ai_terminal:/home/mathieu/crypto_ai_terminal/core
ExecStart=/home/mathieu/crypto_ai_terminal/.venv/bin/python -m src.telegram.quant_observer.bot
Restart=on-failure
RestartSec=10s
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=crypto_quant_observer
Nice=10
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
