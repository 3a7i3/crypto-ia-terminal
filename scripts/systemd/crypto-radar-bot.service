# CryptoRadar — bot Telegram interactif, LECTURE SEULE sur les decisions (ADR-0007).
# Polling long getUpdates, repond aux commandes /scan /signals /top50 /longs
# /shorts /symbol /status.
#
# Prerequis dans .env :
#   TELEGRAM_BOT_TOKEN=<token bot CryptoRadar>
#   TELEGRAM_CHAT_ID=<id chat autorise>
#
# Installation (VPS, geste operateur) :
#   sudo cp scripts/systemd/crypto-radar-bot.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now crypto-radar-bot.service
#   sudo systemctl status crypto-radar-bot.service
[Unit]
Description=CryptoRadar — bot Telegram interactif (lecture seule, ADR-0007)
After=network-online.target crypto-advisor.service
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=mathieu
WorkingDirectory=/home/mathieu/crypto_ai_terminal
EnvironmentFile=-/home/mathieu/crypto_ai_terminal/.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONIOENCODING=utf-8
Environment=TZ=UTC
Environment=PYTHONPATH=/home/mathieu/crypto_ai_terminal
ExecStart=/home/mathieu/crypto_ai_terminal/.venv/bin/python scripts/radar_bot.py
Restart=on-failure
RestartSec=10s
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=crypto_radar_bot
Nice=10
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
