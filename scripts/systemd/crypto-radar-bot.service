# CryptoRadar — bot Telegram interactif, LECTURE SEULE sur les decisions (ADR-0007).
# Polling long getUpdates, repond aux commandes /scan /top50 /longs /shorts /symbol /lmi.
#
# Isolation du token (constitution Telegram — docs/TELEGRAM_CONSTITUTION.md,
# Principe 3 : "No Cross-Identity Token Fallback") :
#   RADAR_BOT_TOKEN + RADAR_CHAT_ID sont OBLIGATOIRES et n'ont plus de fallback
#   vers TELEGRAM_BOT_TOKEN / TELEGRAM_CHAT_ID. Le script quitte avec le code 1
#   si RADAR_BOT_TOKEN est absent — voir scripts/radar_bot.py.
#
# Prerequis dans .env.secrets :
#   RADAR_BOT_TOKEN=<token bot CryptoRadar dedie, cree via @BotFather>
#   RADAR_CHAT_ID=<id chat autorise>
#
# SEC-API-01 : le secret store est conserve pour l'identite Telegram, mais les
# credentials d'exchange sont retirees de l'environnement final du processus.
#
# Installation (VPS, geste operateur) :
#   sudo cp scripts/systemd/crypto-radar-bot.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now crypto-radar-bot.service
#   sudo systemctl status crypto-radar-bot.service
[Unit]
Description=CryptoRadar — bot Telegram interactif (lecture seule, ADR-0007)
After=network-online.target crypto-advisor.service
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=mathieu
WorkingDirectory=/home/mathieu/crypto_ai_terminal
EnvironmentFile=-/home/mathieu/crypto_ai_terminal/.env
EnvironmentFile=-/home/mathieu/crypto_ai_terminal/.env.secrets
UnsetEnvironment=MEXC_API_KEY MEXC_API_SECRET MEXC_SECRET_KEY BINANCE_API_KEY BINANCE_API_SECRET BINANCE_LIVE_API_KEY BINANCE_LIVE_API_SECRET BINANCE_FUTURES_DEMO_KEY BINANCE_FUTURES_DEMO_SECRET BINANCE_SECRET KRAKEN_API_KEY KRAKEN_API_SECRET GATEIO_API_KEY GATEIO_API_SECRET BYBIT_API_KEY BYBIT_API_SECRET OKX_API_KEY OKX_API_SECRET OKX_PASSWORD LIVE_READER_API_KEY LIVE_READER_API_SECRET
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONIOENCODING=utf-8
Environment=TZ=UTC
Environment=PYTHONPATH=/home/mathieu/crypto_ai_terminal
ExecStart=/home/mathieu/crypto_ai_terminal/.venv/bin/python scripts/radar_bot.py
Restart=on-failure
RestartSec=10s
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=crypto_radar_bot
Nice=10
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
