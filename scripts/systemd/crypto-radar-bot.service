# CryptoRadar — bot Telegram interactif, LECTURE SEULE sur les decisions (ADR-0007).
# SEC-API-01 — least-privilege service identity.
#
# Public/non-secret configuration:
#   /home/mathieu/crypto_ai_terminal/.env
#
# Required runtime-only secret fragment (HUMAN_ONLY, never committed):
#   /etc/crypto-ai/secrets/radar-bot.env
# containing only:
#   RADAR_BOT_TOKEN
#   RADAR_CHAT_ID
#
# Mandatory EnvironmentFile: the service must never inherit Quant, dashboard
# or exchange credentials from the global .env.secrets store.
[Unit]
Description=CryptoRadar — bot Telegram interactif (lecture seule, ADR-0007)
After=network-online.target crypto-advisor.service
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=mathieu
WorkingDirectory=/home/mathieu/crypto_ai_terminal
EnvironmentFile=-/home/mathieu/crypto_ai_terminal/.env
EnvironmentFile=/etc/crypto-ai/secrets/radar-bot.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONIOENCODING=utf-8
Environment=TZ=UTC
Environment=PYTHONPATH=/home/mathieu/crypto_ai_terminal
ExecStart=/home/mathieu/crypto_ai_terminal/.venv/bin/python scripts/radar_bot.py
Restart=on-failure
RestartSec=10s
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=crypto_radar_bot
Nice=10
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
