import pandas as pd
import ipywidgets as widgets
from IPython.display import display
# Exemple de données
df = pd.DataFrame({
    'Actif': ['BTC', 'ETH', 'SOL', 'BNB'],
    'Volume': [1200, 800, 450, 600],
