                "ask_qty": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^-?[0-9]{1,101}(\\.[0-9]{1,100})?$",
                      "maxLength": 203
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "source_ms": {
                  "type": "null"
                },
                "received_ms": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[1-9][0-9]{0,14}$"
