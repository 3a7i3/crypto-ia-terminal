                "price_change_ratio_raw",
                "change_pct_24h",
                "change_method",
                "change_qualified",
                "volume_qualified",
                "source_open_ms",
                "source_close_ms",
                "received_ms",
                "raw_sha256"
              ],
              "properties": {
                "last_price": {
                  "type": "string",
                  "pattern": "^-?[0-9]{1,101}(\\.[0-9]{1,100})?$",
                  "maxLength": 203
                },
                "open_price": {
                  "type": "string",
                  "pattern": "^-?[0-9]{1,101}(\\.[0-9]{1,100})?$",
                  "maxLength": 203
                },
                "high_price": {
                  "type": "string",
                  "pattern": "^-?[0-9]{1,101}(\\.[0-9]{1,100})?$",
                  "maxLength": 203
                },
                "low_price": {
                  "type": "string",
                  "pattern": "^-?[0-9]{1,101}(\\.[0-9]{1,100})?$",
                  "maxLength": 203
                },
                "base_volume_24h": {
                  "type": "string",
                  "pattern": "^-?[0-9]{1,101}(\\.[0-9]{1,100})?$",
                  "maxLength": 203
                },
                "quote_volume_24h": {
                  "type": "string",
                  "pattern": "^-?[0-9]{1,101}(\\.[0-9]{1,100})?$",
                  "maxLength": 203
                },
                "price_change_raw": {
                  "type": "string",
                  "pattern": "^-?[0-9]{1,101}(\\.[0-9]{1,100})?$",
                  "maxLength": 203
                },
                "price_change_ratio_raw": {
                  "type": "string",
                  "pattern": "^-?[0-9]{1,101}(\\.[0-9]{1,100})?$",
                  "maxLength": 203
                },
                "change_pct_24h": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^-?[0-9]{1,101}(\\.[0-9]{1,100})?$",
                      "maxLength": 203
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "change_method": {
                  "enum": [
                    "MEXC_RATIO_X100_ARITHMETICALLY_CHECKED",
                    "UNRESOLVED"
                  ]
