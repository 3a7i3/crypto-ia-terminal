                "age_ms": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1000000000000000
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "reason": {
                  "type": "string",
                  "maxLength": 180
                }
              }
            },
            "timeframes": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "symbol",
                  "timeframe",
                  "sha256",
                  "history_count",
                  "closed_count",
                  "quality",
                  "received_ms",
                  "gap_count",
                  "rejected",
                  "duplicates",
                  "conflicts"
                ],
                "properties": {
                  "symbol": {
                    "type": "string",
                    "pattern": "^[A-Z0-9]{2,40}$"
                  },
                  "timeframe": {
                    "enum": [
                      "M5",
                      "M15",
                      "H1",
                      "H4"
                    ]
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "history_count": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 300
                  },
                  "closed_count": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 300
                  },
                  "quality": {
                    "enum": [
                      "COMPLETE",
                      "PARTIAL"
                    ]
                  },
                  "received_ms": {
                    "type": "string",
                    "pattern": "^[1-9][0-9]{0,14}$"
                  },
                  "gap_count": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 300
                  },
                  "rejected": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 300
                  },
                  "duplicates": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 300
                  },
                  "conflicts": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 300
                  }
                }
              },
              "maxItems": 4
            }
          }
        },
        "maxItems": 30
      },
      "returned_count": {
        "type": "integer",
        "minimum": 0,
        "maximum": 30
      },
      "complete": {
        "const": true
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:cat:spot-radar:1.0.0:api:scanner"
