                "quality": {
                  "enum": [
                    "RECEIPT_ONLY",
                    "INVALID",
                    "NOT_AVAILABLE"
                  ]
                }
              }
            },
            "freshness": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "state",
                "age_ms",
                "reason"
              ],
              "properties": {
                "state": {
                  "enum": [
                    "LIVE",
                    "STALE",
                    "DISCONNECTED",
                    "UNRESOLVED",
                    "SYNTHETIC"
