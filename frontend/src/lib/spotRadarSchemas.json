        "const": "spot-radar/1.0.0"
      },
      "evidence_kind": {
        "enum": [
          "PUBLIC_OBSERVED",
          "SYNTHETIC"
        ]
      },
      "source": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "exchange",
          "market",
          "transport",
          "base_url",
          "selection_sha256",
          "metadata_sha256"
        ],
        "properties": {
          "exchange": {
            "const": "mexc"
          },
          "market": {
            "const": "spot"
          },
          "transport": {
            "const": "PUBLIC_REST"
          },
          "base_url": {
            "const": "https://api.mexc.com"
          },
          "selection_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "metadata_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      },
      "clock": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "server_ms",
          "requested_ms",
          "received_ms",
          "rtt_ms"
        ],
        "properties": {
          "server_ms": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,14}$"
          },
          "requested_ms": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,14}$"
          },
          "received_ms": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,14}$"
          },
          "rtt_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 60000
          }
        }
      },
      "unavailable": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
