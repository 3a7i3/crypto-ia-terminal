{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crypto-ia-terminal:agent-econ:a1:agent-spec:v1",
  "title": "AGENT-ECON A1 AgentSpec v1 (contract only, NON_DEPLOYED)",
  "description": "Declarative structural contract for an AgentSpec. No loader, registry or runtime consumes this file. Structural checks only: identity recomputation (agent_id, agent_spec_id), canonical ordering of arrays, cross-agent independence and registry state are enforced by the A1 source mission, not by this schema. Unknown capability, unknown class, unknown field, active provider binding, credential, human decision or non-ceiling authority are all rejected.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "agent_schema",
    "agent_id",
    "agent_spec_id",
    "spec_revision",
    "constitution_version",
    "namespace",
    "canonical_name",
    "display_name",
    "agent_class",
    "maintenance_level",
    "purpose",
    "capabilities",
    "scope_policy",
    "independence_policy",
    "authority_policy",
    "execution_binding",
    "supersedes_spec_id",
    "created_from_ref",
    "created_at_utc"
  ],
  "properties": {
    "agent_schema": {
      "const": "AGENT_ECON_A1_AGENT_SPEC_V1"
    },
    "agent_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "agent_spec_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "spec_revision": {
      "type": "integer",
      "minimum": 1
    },
    "constitution_version": {
      "const": "AGENT_ECON_A0_FOREST_V1"
    },
    "namespace": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
      "maxLength": 64
    },
    "canonical_name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
      "maxLength": 64
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "agent_class": {
      "enum": [
        "SENSOR",
        "SCOUT",
        "CURATOR",
        "ENGINEER",
        "UX",
        "TEST_VERIFIER",
        "FORENSIC",
        "DATA_STEWARD",
        "RESEARCH",
        "STRATEGY",
        "SECURITY",
        "SRE",
        "REVIEWER",
        "GOVERNANCE"
      ]
    },
    "maintenance_level": {
      "enum": [
        "F0",
        "F1",
        "F2",
        "F3",
        "F4"
      ]
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "ACCEPTANCE_CRITERIA_DRAFT_PRODUCE",
          "ARCHITECTURE_REVIEW",
          "BOUNTY_DRAFT_PRODUCE",
          "BRANCH_PREPARE",
          "CANDIDATE_PROBLEM_PROPOSE",
          "CI_READ",
          "DATA_PROVENANCE_REVIEW",
          "DIAGNOSTIC_PRODUCE",
          "GITHUB_METADATA_READ",
          "GOVERNANCE_REVIEW",
          "GOVERNED_ARTIFACT_READ",
          "PROBLEM_DEDUPLICATE",
          "PROBLEM_VERIFY",
          "PR_PREPARE",
          "REPOSITORY_READ",
          "REPOSITORY_SEARCH",
          "SCOPE_DRAFT_PRODUCE",
          "SECURITY_REVIEW",
          "SOURCE_EDIT_ISOLATED",
          "STATIC_ANALYSIS",
          "STATISTICAL_REVIEW",
          "TEST_REVIEW",
          "TEST_RUN_ISOLATED"
        ]
      },
      "minItems": 1
    },
    "scope_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_read_paths",
        "repository_write_paths_future",
        "github_surfaces",
        "artifact_domains"
      ],
      "properties": {
        "repository_read_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?!/)(?!\\.{1,2}/?$)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.env)(?!.*\\.(?:pem|key)$)(?:[A-Za-z0-9_]|\\.github/|\\.ci/)[A-Za-z0-9._/-]*$",
            "maxLength": 256
          }
        },
        "repository_write_paths_future": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?!(?:core|paper_trading|financial_institute|runtime|config|deploy|scripts|governance|\\.github|\\.ci|observability/operator_decisions)(?:/|$))(?!/)(?!\\.{1,2}/?$)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.env)(?!.*\\.(?:pem|key)$)[A-Za-z0-9_][A-Za-z0-9._/-]*$",
            "maxLength": 256
          }
        },
        "github_surfaces": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "CHECK_RUNS_READ",
              "COMMITS_READ",
              "ISSUES_READ",
              "PULL_REQUESTS_READ",
              "WORKFLOW_RUNS_READ"
            ]
          }
        },
        "artifact_domains": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "BURNIN_CHECKPOINT_EVIDENCE",
              "CI_ARTIFACTS",
              "RESEARCH_DATASET_IMMUTABLE",
              "RESEARCH_PUBLICATION"
            ]
          }
        }
      }
    },
    "independence_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "own_work_review_forbidden",
        "independent_review_required"
      ],
      "properties": {
        "own_work_review_forbidden": {
          "const": true
        },
        "independent_review_required": {
          "const": true
        }
      }
    },
    "authority_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_ceiling",
        "human_decision",
        "economic_status_grants_authority",
        "reputation_grants_authority",
        "consensus_grants_authority"
      ],
      "properties": {
        "authority_ceiling": {
          "const": "NO_RUNTIME_AUTHORITY"
        },
        "human_decision": {
          "const": false
        },
        "economic_status_grants_authority": {
          "const": false
        },
        "reputation_grants_authority": {
          "const": false
        },
        "consensus_grants_authority": {
          "const": false
        }
      }
    },
    "execution_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "provider",
        "model",
        "credential_mode"
      ],
      "properties": {
        "status": {
          "const": "UNBOUND"
        },
        "provider": {
          "type": "null"
        },
        "model": {
          "type": "null"
        },
        "credential_mode": {
          "const": "NONE"
        }
      }
    },
    "supersedes_spec_id": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      ]
    },
    "created_from_ref": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "created_at_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,6})?Z$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "maintenance_level": {
            "const": "F0"
          }
        },
        "required": [
          "maintenance_level"
        ]
      },
      "then": {
        "properties": {
          "capabilities": {
            "items": {
              "enum": [
                "CI_READ",
                "GITHUB_METADATA_READ",
                "GOVERNED_ARTIFACT_READ",
                "REPOSITORY_READ",
                "REPOSITORY_SEARCH",
                "STATIC_ANALYSIS"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "maintenance_level": {
            "const": "F1"
          }
        },
        "required": [
          "maintenance_level"
        ]
      },
      "then": {
        "properties": {
          "capabilities": {
            "items": {
              "enum": [
                "CANDIDATE_PROBLEM_PROPOSE",
                "CI_READ",
                "GITHUB_METADATA_READ",
                "GOVERNED_ARTIFACT_READ",
                "REPOSITORY_READ",
                "REPOSITORY_SEARCH",
                "STATIC_ANALYSIS"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "maintenance_level": {
            "const": "F2"
          }
        },
        "required": [
          "maintenance_level"
        ]
      },
      "then": {
        "properties": {
          "capabilities": {
            "items": {
              "enum": [
                "ACCEPTANCE_CRITERIA_DRAFT_PRODUCE",
                "BOUNTY_DRAFT_PRODUCE",
                "CI_READ",
                "DIAGNOSTIC_PRODUCE",
                "GITHUB_METADATA_READ",
                "GOVERNED_ARTIFACT_READ",
                "PROBLEM_DEDUPLICATE",
                "PROBLEM_VERIFY",
                "REPOSITORY_READ",
                "REPOSITORY_SEARCH",
                "SCOPE_DRAFT_PRODUCE",
                "STATIC_ANALYSIS"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "maintenance_level": {
            "const": "F3"
          }
        },
        "required": [
          "maintenance_level"
        ]
      },
      "then": {
        "properties": {
          "capabilities": {
            "items": {
              "enum": [
                "BRANCH_PREPARE",
                "CI_READ",
                "GITHUB_METADATA_READ",
                "GOVERNED_ARTIFACT_READ",
                "PR_PREPARE",
                "REPOSITORY_READ",
                "REPOSITORY_SEARCH",
                "SOURCE_EDIT_ISOLATED",
                "STATIC_ANALYSIS",
                "TEST_RUN_ISOLATED"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "maintenance_level": {
            "const": "F4"
          }
        },
        "required": [
          "maintenance_level"
        ]
      },
      "then": {
        "properties": {
          "capabilities": {
            "items": {
              "enum": [
                "ARCHITECTURE_REVIEW",
                "CI_READ",
                "DATA_PROVENANCE_REVIEW",
                "GITHUB_METADATA_READ",
                "GOVERNANCE_REVIEW",
                "GOVERNED_ARTIFACT_READ",
                "REPOSITORY_READ",
                "REPOSITORY_SEARCH",
                "SECURITY_REVIEW",
                "STATIC_ANALYSIS",
                "STATISTICAL_REVIEW",
                "TEST_REVIEW"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "agent_class": {
            "const": "SENSOR"
          }
        },
        "required": [
          "agent_class"
        ]
      },
      "then": {
        "properties": {
          "maintenance_level": {
            "enum": [
              "F0"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "agent_class": {
            "const": "SCOUT"
          }
        },
        "required": [
          "agent_class"
        ]
      },
      "then": {
        "properties": {
          "maintenance_level": {
            "enum": [
              "F1"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "agent_class": {
            "const": "CURATOR"
          }
        },
        "required": [
          "agent_class"
        ]
      },
      "then": {
        "properties": {
          "maintenance_level": {
            "enum": [
              "F2"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "agent_class": {
            "const": "ENGINEER"
          }
        },
        "required": [
          "agent_class"
        ]
      },
      "then": {
        "properties": {
          "maintenance_level": {
            "enum": [
              "F3"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "agent_class": {
            "const": "UX"
          }
        },
        "required": [
          "agent_class"
        ]
      },
      "then": {
        "properties": {
          "maintenance_level": {
            "enum": [
              "F3"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "agent_class": {
            "const": "TEST_VERIFIER"
          }
        },
        "required": [
          "agent_class"
        ]
      },
      "then": {
        "properties": {
          "maintenance_level": {
            "enum": [
              "F4"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "agent_class": {
            "const": "FORENSIC"
          }
        },
        "required": [
          "agent_class"
        ]
      },
      "then": {
        "properties": {
          "maintenance_level": {
            "enum": [
              "F0",
              "F1",
              "F2"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "agent_class": {
            "const": "DATA_STEWARD"
          }
        },
        "required": [
          "agent_class"
        ]
      },
      "then": {
        "properties": {
          "maintenance_level": {
            "enum": [
              "F2",
              "F4"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "agent_class": {
            "const": "RESEARCH"
          }
        },
        "required": [
          "agent_class"
        ]
      },
      "then": {
        "properties": {
          "maintenance_level": {
            "enum": [
              "F0",
              "F1",
              "F2"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "agent_class": {
            "const": "STRATEGY"
          }
        },
        "required": [
          "agent_class"
        ]
      },
      "then": {
        "properties": {
          "maintenance_level": {
            "enum": [
              "F0",
              "F1"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "agent_class": {
            "const": "SECURITY"
          }
        },
        "required": [
          "agent_class"
        ]
      },
      "then": {
        "properties": {
          "maintenance_level": {
            "enum": [
              "F1",
              "F2",
              "F4"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "agent_class": {
            "const": "SRE"
          }
        },
        "required": [
          "agent_class"
        ]
      },
      "then": {
        "properties": {
          "maintenance_level": {
            "enum": [
              "F1",
              "F2"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "agent_class": {
            "const": "REVIEWER"
          }
        },
        "required": [
          "agent_class"
        ]
      },
      "then": {
        "properties": {
          "maintenance_level": {
            "enum": [
              "F4"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "agent_class": {
            "const": "GOVERNANCE"
          }
        },
        "required": [
          "agent_class"
        ]
      },
      "then": {
        "properties": {
          "maintenance_level": {
            "enum": [
              "F4"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "capabilities": {
            "contains": {
              "const": "SOURCE_EDIT_ISOLATED"
            }
          }
        },
        "required": [
          "capabilities"
        ]
      },
      "then": {
        "properties": {
          "scope_policy": {
            "properties": {
              "repository_write_paths_future": {
                "minItems": 1
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "scope_policy": {
            "properties": {
              "repository_write_paths_future": {
                "maxItems": 0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "anyOf": [
          {
            "properties": {
              "capabilities": {
                "contains": {
                  "const": "REPOSITORY_READ"
                }
              }
            },
            "required": [
              "capabilities"
            ]
          },
          {
            "properties": {
              "capabilities": {
                "contains": {
                  "const": "REPOSITORY_SEARCH"
                }
              }
            },
            "required": [
              "capabilities"
            ]
          },
          {
            "properties": {
              "capabilities": {
                "contains": {
                  "const": "STATIC_ANALYSIS"
                }
              }
            },
            "required": [
              "capabilities"
            ]
          }
        ]
      },
      "then": {
        "properties": {
          "scope_policy": {
            "properties": {
              "repository_read_paths": {
                "minItems": 1
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "scope_policy": {
            "properties": {
              "repository_read_paths": {
                "maxItems": 0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "capabilities": {
            "contains": {
              "const": "GOVERNED_ARTIFACT_READ"
            }
          }
        },
        "required": [
          "capabilities"
        ]
      },
      "then": {
        "properties": {
          "scope_policy": {
            "properties": {
              "artifact_domains": {
                "minItems": 1
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "scope_policy": {
            "properties": {
              "artifact_domains": {
                "maxItems": 0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "anyOf": [
          {
            "properties": {
              "capabilities": {
                "contains": {
                  "const": "CI_READ"
                }
              }
            },
            "required": [
              "capabilities"
            ]
          },
          {
            "properties": {
              "capabilities": {
                "contains": {
                  "const": "GITHUB_METADATA_READ"
                }
              }
            },
            "required": [
              "capabilities"
            ]
          }
        ]
      },
      "then": {
        "properties": {
          "scope_policy": {
            "properties": {
              "github_surfaces": {
                "minItems": 1
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "scope_policy": {
            "properties": {
              "github_surfaces": {
                "maxItems": 0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "spec_revision": {
            "const": 1
          }
        },
        "required": [
          "spec_revision"
        ]
      },
      "then": {
        "properties": {
          "supersedes_spec_id": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "supersedes_spec_id": {
            "type": "string"
          }
        }
      }
    }
  ]
}
