{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crypto-ia-terminal:agent-econ:a1:agent-spec:v1",
  "title": "AGENT_SPEC_V1",
  "description": "Declarative, closed, fail-closed schema of an AgentSpec (AGENT-ECON A1, reconciliation R1). CONTRACT ONLY: no loader, no registry, no runtime consumer exists. A valid AgentSpec is a well-formed declaration; it is NOT an authorization, NOT a running agent and NOT proof of registration. S = expressed by this schema. V = future validator, NOT expressed here: sorted order of arrays, NFC normalisation and canonical text, rejection of 1.0 / float as integer, recomputation of agent_id/agent_spec_id/spec_artifact_hash, supersession-chain continuity, and the per-capability mapping to github_surfaces (only the presence/absence coupling between capabilities and scope lists is S). See docs/contracts/AGENT_ECON_A1_AGENT_REGISTRY_CONTRACT.md sections 3, 4 and 9.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "agent_schema",
    "constitution_version",
    "agent_id",
    "agent_spec_id",
    "spec_revision",
    "namespace",
    "canonical_name",
    "display_name",
    "agent_class",
    "maintenance_level",
    "purpose",
    "capabilities",
    "scope_policy",
    "independence_policy",
    "authority_policy",
    "execution_binding",
    "supersedes_spec_id",
    "created_from_ref",
    "created_at_utc"
  ],
  "properties": {
    "agent_schema": {
      "const": "AGENT_SPEC_V1"
    },
    "constitution_version": {
      "const": "AGENT_ECON_A0_FOREST_V1",
      "description": "Constitution under which this spec was produced. Distinct from agent_schema: the technical schema may evolve without a constitutional change and vice versa. Material for agent_spec_id."
    },
    "agent_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "agent_spec_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "spec_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "namespace": {
      "const": "forest"
    },
    "canonical_name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,63}$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^\\S(.*\\S)?$"
    },
    "agent_class": {
      "enum": [
        "CURATOR",
        "DATA_STEWARD",
        "ENGINEER",
        "FORENSIC",
        "GOVERNANCE",
        "RESEARCH",
        "REVIEWER",
        "SCOUT",
        "SECURITY",
        "SENSOR",
        "SRE",
        "STRATEGY",
        "TEST_VERIFIER",
        "UX"
      ]
    },
    "maintenance_level": {
      "enum": [
        "F0",
        "F1",
        "F2"
      ],
      "description": "F3 and F4 are RESERVED vocabulary (A0). They are not admissible in AGENT_SPEC_V1."
    },
    "purpose": {
      "type": "string",
      "minLength": 20,
      "maxLength": 600,
      "pattern": "^\\S(.|\\n)*\\S$"
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 1,
      "maxItems": 14,
      "items": {
        "enum": [
          "ACCEPTANCE_CRITERIA_DRAFT_PREPARE",
          "BOUNTY_DRAFT_PREPARE",
          "CANDIDATE_PROBLEM_PROPOSE",
          "CI_READ",
          "DIAGNOSTIC_PRODUCE",
          "GITHUB_METADATA_READ",
          "GOVERNED_ARTIFACT_READ",
          "PROBLEM_CHARACTERIZE",
          "PROBLEM_DEDUPLICATE",
          "PROBLEM_VERIFY",
          "REPOSITORY_READ",
          "REPOSITORY_SEARCH",
          "SCOPE_DRAFT_PREPARE",
          "STATIC_ANALYSIS"
        ]
      }
    },
    "scope_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_read_paths",
        "repository_write_paths_future",
        "github_surfaces",
        "artifact_domains"
      ],
      "properties": {
        "repository_read_paths": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 64,
          "items": {
            "type": "string",
            "pattern": "^(?!/)(?!.*//)(?!(.*/)?\\.{1,2}(/|$))(?!(.*/)?\\.env)(?!.*\\.(pem|key|p12|pfx)$)(?!(.*/)?(id_rsa|id_ed25519)[^/]*$)(?!(.*/)?secrets?(/|$))[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*/?$"
          },
          "description": "Exact relative file path, OR relative directory prefix ending with '/'. No glob (no * ? [ ]), no absolute path, no '..', no '.env*', no key/secret path. Globs may only be introduced by a later governed schema version."
        },
        "repository_write_paths_future": {
          "type": "array",
          "maxItems": 0,
          "description": "Reserved for F3 (not admissible in V1): MUST be empty."
        },
        "github_surfaces": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 6,
          "items": {
            "enum": [
              "BRANCHES",
              "CHECK_RUNS",
              "COMMITS",
              "ISSUES",
              "PULL_REQUESTS",
              "WORKFLOW_RUNS"
            ]
          },
          "description": "READ-ONLY surfaces. There is no GitHub write surface in V1."
        },
        "artifact_domains": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 6,
          "items": {
            "enum": [
              "CI_ARTIFACTS",
              "GOVERNANCE_DOCUMENTS",
              "OPERATOR_API_PROJECTIONS",
              "PAPER_CERTIFIED_EXPORTS",
              "RESEARCH_DATASETS_IMMUTABLE",
              "RESEARCH_PUBLICATIONS"
            ]
          },
          "description": "READ-ONLY certified/immutable artifact families. No runtime, VPS, PPL-authoritative ledger, FIN ledger, exchange or secret domain exists in V1."
        }
      }
    },
    "independence_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "own_work_review_forbidden",
        "independent_review_required"
      ],
      "properties": {
        "own_work_review_forbidden": {
          "const": true
        },
        "independent_review_required": {
          "const": true
        }
      }
    },
    "authority_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_ceiling",
        "human_decision",
        "economic_status_grants_authority",
        "reputation_grants_authority",
        "consensus_grants_authority"
      ],
      "properties": {
        "authority_ceiling": {
          "const": "NO_RUNTIME_AUTHORITY"
        },
        "human_decision": {
          "const": false
        },
        "economic_status_grants_authority": {
          "const": false
        },
        "reputation_grants_authority": {
          "const": false
        },
        "consensus_grants_authority": {
          "const": false
        }
      }
    },
    "execution_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "provider",
        "model",
        "credential_mode"
      ],
      "properties": {
        "status": {
          "const": "UNBOUND"
        },
        "provider": {
          "type": "null"
        },
        "model": {
          "type": "null"
        },
        "credential_mode": {
          "const": "NONE"
        }
      }
    },
    "supersedes_spec_id": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      ]
    },
    "created_from_ref": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "description": "Exact 40-hex commit SHA of the governed source this spec was authored from. A branch/tag name is ambiguous and rejected."
    },
    "created_at_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,6})?Z$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "maintenance_level": {
            "const": "F0"
          }
        },
        "required": [
          "maintenance_level"
        ]
      },
      "then": {
        "properties": {
          "capabilities": {
            "items": {
              "enum": [
                "CI_READ",
                "GITHUB_METADATA_READ",
                "GOVERNED_ARTIFACT_READ",
                "REPOSITORY_READ",
                "REPOSITORY_SEARCH",
                "STATIC_ANALYSIS"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "maintenance_level": {
            "const": "F1"
          }
        },
        "required": [
          "maintenance_level"
        ]
      },
      "then": {
        "properties": {
          "capabilities": {
            "items": {
              "enum": [
                "CANDIDATE_PROBLEM_PROPOSE",
                "CI_READ",
                "GITHUB_METADATA_READ",
                "GOVERNED_ARTIFACT_READ",
                "REPOSITORY_READ",
                "REPOSITORY_SEARCH",
                "STATIC_ANALYSIS"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "maintenance_level": {
            "const": "F2"
          }
        },
        "required": [
          "maintenance_level"
        ]
      },
      "then": {
        "properties": {
          "capabilities": {
            "items": {
              "enum": [
                "ACCEPTANCE_CRITERIA_DRAFT_PREPARE",
                "BOUNTY_DRAFT_PREPARE",
                "CANDIDATE_PROBLEM_PROPOSE",
                "CI_READ",
                "DIAGNOSTIC_PRODUCE",
                "GITHUB_METADATA_READ",
                "GOVERNED_ARTIFACT_READ",
                "PROBLEM_CHARACTERIZE",
                "PROBLEM_DEDUPLICATE",
                "PROBLEM_VERIFY",
                "REPOSITORY_READ",
                "REPOSITORY_SEARCH",
                "SCOPE_DRAFT_PREPARE",
                "STATIC_ANALYSIS"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "agent_class": {
            "const": "CURATOR"
          }
        },
        "required": [
          "agent_class"
        ]
      },
      "then": {
        "properties": {
          "maintenance_level": {
            "enum": [
              "F0",
              "F1",
              "F2"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "agent_class": {
            "const": "DATA_STEWARD"
          }
        },
        "required": [
          "agent_class"
        ]
      },
      "then": {
        "properties": {
          "maintenance_level": {
            "enum": [
              "F0",
              "F1",
              "F2"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "agent_class": {
            "const": "ENGINEER"
          }
        },
        "required": [
          "agent_class"
        ]
      },
      "then": {
        "properties": {
          "maintenance_level": false
        },
        "required": [
          "maintenance_level"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "agent_class": {
            "const": "FORENSIC"
          }
        },
        "required": [
          "agent_class"
        ]
      },
      "then": {
        "properties": {
          "maintenance_level": {
            "enum": [
              "F0",
              "F1",
              "F2"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "agent_class": {
            "const": "GOVERNANCE"
          }
        },
        "required": [
          "agent_class"
        ]
      },
      "then": {
        "properties": {
          "maintenance_level": false
        },
        "required": [
          "maintenance_level"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "agent_class": {
            "const": "RESEARCH"
          }
        },
        "required": [
          "agent_class"
        ]
      },
      "then": {
        "properties": {
          "maintenance_level": {
            "enum": [
              "F0",
              "F1"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "agent_class": {
            "const": "REVIEWER"
          }
        },
        "required": [
          "agent_class"
        ]
      },
      "then": {
        "properties": {
          "maintenance_level": false
        },
        "required": [
          "maintenance_level"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "agent_class": {
            "const": "SCOUT"
          }
        },
        "required": [
          "agent_class"
        ]
      },
      "then": {
        "properties": {
          "maintenance_level": {
            "enum": [
              "F0",
              "F1"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "agent_class": {
            "const": "SECURITY"
          }
        },
        "required": [
          "agent_class"
        ]
      },
      "then": {
        "properties": {
          "maintenance_level": {
            "enum": [
              "F0",
              "F1",
              "F2"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "agent_class": {
            "const": "SENSOR"
          }
        },
        "required": [
          "agent_class"
        ]
      },
      "then": {
        "properties": {
          "maintenance_level": {
            "enum": [
              "F0"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "agent_class": {
            "const": "SRE"
          }
        },
        "required": [
          "agent_class"
        ]
      },
      "then": {
        "properties": {
          "maintenance_level": {
            "enum": [
              "F0",
              "F1",
              "F2"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "agent_class": {
            "const": "STRATEGY"
          }
        },
        "required": [
          "agent_class"
        ]
      },
      "then": {
        "properties": {
          "maintenance_level": {
            "enum": [
              "F0",
              "F1"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "agent_class": {
            "const": "TEST_VERIFIER"
          }
        },
        "required": [
          "agent_class"
        ]
      },
      "then": {
        "properties": {
          "maintenance_level": false
        },
        "required": [
          "maintenance_level"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "agent_class": {
            "const": "UX"
          }
        },
        "required": [
          "agent_class"
        ]
      },
      "then": {
        "properties": {
          "maintenance_level": false
        },
        "required": [
          "maintenance_level"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "spec_revision": {
            "const": 1
          }
        },
        "required": [
          "spec_revision"
        ]
      },
      "then": {
        "properties": {
          "supersedes_spec_id": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "supersedes_spec_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    {
      "if": {
        "anyOf": [
          {
            "properties": {
              "capabilities": {
                "contains": {
                  "const": "REPOSITORY_READ"
                }
              }
            },
            "required": [
              "capabilities"
            ]
          },
          {
            "properties": {
              "capabilities": {
                "contains": {
                  "const": "REPOSITORY_SEARCH"
                }
              }
            },
            "required": [
              "capabilities"
            ]
          },
          {
            "properties": {
              "capabilities": {
                "contains": {
                  "const": "STATIC_ANALYSIS"
                }
              }
            },
            "required": [
              "capabilities"
            ]
          }
        ]
      },
      "then": {
        "properties": {
          "scope_policy": {
            "properties": {
              "repository_read_paths": {
                "minItems": 1
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "scope_policy": {
            "properties": {
              "repository_read_paths": {
                "maxItems": 0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "anyOf": [
          {
            "properties": {
              "capabilities": {
                "contains": {
                  "const": "CI_READ"
                }
              }
            },
            "required": [
              "capabilities"
            ]
          },
          {
            "properties": {
              "capabilities": {
                "contains": {
                  "const": "GITHUB_METADATA_READ"
                }
              }
            },
            "required": [
              "capabilities"
            ]
          }
        ]
      },
      "then": {
        "properties": {
          "scope_policy": {
            "properties": {
              "github_surfaces": {
                "minItems": 1
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "scope_policy": {
            "properties": {
              "github_surfaces": {
                "maxItems": 0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "capabilities": {
            "contains": {
              "const": "GOVERNED_ARTIFACT_READ"
            }
          }
        },
        "required": [
          "capabilities"
        ]
      },
      "then": {
        "properties": {
          "scope_policy": {
            "properties": {
              "artifact_domains": {
                "minItems": 1
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "scope_policy": {
            "properties": {
              "artifact_domains": {
                "maxItems": 0
              }
            }
          }
        }
      }
    }
  ]
}
