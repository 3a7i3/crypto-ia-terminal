# OPTION P6-GOV-02-RV (non installée par le script ; décision opérateur et GO runtime distincts).
# Ferme la limite locale du relais : au lieu d'écouter sur 127.0.0.1:8181, joignable par tout
# utilisateur Unix local capable de forger Tailscale-User-Login, le relais reçoit de systemd une socket
# Unix appartenant à root en 0600. Seul root (tailscaled) peut s'y connecter.
# Mise en place : installer cette unité (crypto-operator-web.socket), ajouter
#   Requires=crypto-operator-web.socket / After=crypto-operator-web.socket au service Web,
# puis `tailscale serve --bg unix:/run/cat-operator-web.sock` à la place du port 8181.
# Le relais détecte LISTEN_FDS/LISTEN_PID et écoute sur le descripteur 3 (systemdListenFd).
# Retour arrière : rétablir la cible tailscale serve sur 127.0.0.1:8181 et retirer l'unité.
[Unit]
Description=CAT operator web — socket réservée à tailscaled (root)

[Socket]
ListenStream=/run/cat-operator-web.sock
SocketUser=root
SocketGroup=root
SocketMode=0600
RemoveOnStop=yes

[Install]
WantedBy=sockets.target
