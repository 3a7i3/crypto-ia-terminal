+import React from "react";
+import type { Bar, Timeframe } from "../lib/spotRadarClient";
+
+/** Visual scaling only; original decimal strings remain in title and source table. */
+export const RadarCandles: React.FC<{ rows: Bar[]; symbol: string; timeframe: Timeframe }> = ({rows,symbol,timeframe}) => {
+ const bars=rows.slice(-60);
+ if(!bars.length)return <p>Pas de bougies disponibles.</p>;
+ const W=720,H=380,left=14,right=126,top=28,bottom=265;
+ const low=Math.min(...bars.map(b=>Number(b.low))), high=Math.max(...bars.map(b=>Number(b.high)));
+ if(!Number.isFinite(low)||!Number.isFinite(high))return <p>Échelle du graphique indisponible ; valeurs exactes dans le tableau.</p>;
+ const padding=Math.max((high-low)*.06,Math.abs(high)*.00001,Number.MIN_VALUE);
+ const min=low-padding,max=high+padding,span=max-min;
+ if(!Number.isFinite(span)||span<=0)return <p>Échelle du graphique indisponible ; valeurs exactes dans le tableau.</p>;
+ const y=(n:string)=>bottom-(Number(n)-min)/span*(bottom-top);
+ const width=(W-left-right)/bars.length,body=Math.max(1,width*.65);
+ const maxVolume=Math.max(...bars.map(b=>Number(b.base_volume)),1e-100);
+ const stamp=(b:Bar)=>new Date(Number(b.open_ms)).toISOString().slice(11,16);
+ const price=(n:number)=>n.toLocaleString("fr-FR",{maximumSignificantDigits:8});
+ return <figure className="radar-chart">
+  <figcaption>{symbol} · {timeframe} · {bars.length} dernières bougies</figcaption>
+  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`Graphique en chandeliers ${symbol} ${timeframe}, ${bars.length} bougies ; volumes base sous les prix`}>
+   <title>{symbol} {timeframe} — OHLCV MEXC public ; dernière bougie éventuellement partielle</title>
+   {[0,.25,.5,.75,1].map(f=>{const yy=top+f*(bottom-top);return <g key={f}><line x1={left} y1={yy} x2={W-right} y2={yy} stroke="#334155"/><text x={W-right+9} y={yy+6} fill="#cbd5e1" fontSize="18">{price(max-f*span)}</text></g>;})}
+   {bars.map((b,i)=>{const x=left+(i+.5)*width,open=y(b.open),close=y(b.close),up=Number(b.close)>=Number(b.open),color=up?"#63dbb0":"#fb9292";return <g key={b.open_ms}>
+    <title>{stamp(b)} UTC · O {b.open} · H {b.high} · L {b.low} · C {b.close} · Volume {b.base_volume} · {b.closed?"clôturée":"partielle"}</title>
+    <line x1={x} x2={x} y1={y(b.high)} y2={y(b.low)} stroke={color} strokeWidth="1.5"/>
+    <rect x={x-body/2} y={Math.min(open,close)} width={body} height={Math.max(1.5,Math.abs(open-close))} fill={b.closed?color:"#152239"} stroke={color}/>
+    <rect x={x-body/2} y={330-Number(b.base_volume)/maxVolume*45} width={body} height={Math.max(.5,Number(b.base_volume)/maxVolume*45)} fill={color} opacity=".65"/>
+   </g>;})}
+   <text x={left} y="358" fill="#cbd5e1" fontSize="19">{stamp(bars[0])} UTC</text>
+   <text x={W-right} y="358" fill="#cbd5e1" fontSize="19" textAnchor="end">{stamp(bars[bars.length-1])} UTC</text>
+  </svg>
+  <p>Vert : clôture ≥ ouverture · rouge : clôture &lt; ouverture · contour vide : bougie partielle. Volumes en unité de base. Les valeurs exactes restent dans le tableau.</p>
+ </figure>;
+};
