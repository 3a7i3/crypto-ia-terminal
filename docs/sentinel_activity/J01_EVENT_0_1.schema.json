{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:crypto-ia-terminal:sentinel:event:0.1",
  "title": "J01 recorded activity event",
  "description": "SOURCE_ONLY SIMULATED_ONLY. Python validator additionally enforces NFC, strict numeric token types, sorted references, secret rejection, quotas, hashes, producer policy and legal history. Schema validity is not authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "actor_id",
    "actor_kind",
    "actor_version",
    "authorization_ref",
    "causation_event_id",
    "correlation_id",
    "event_id",
    "event_type",
    "evidence_refs",
    "ingestion_policy_version",
    "integrity",
    "ledger_id",
    "occurred_at_utc",
    "payload",
    "producer_id",
    "quest_id",
    "reason_declared",
    "recorded_at_utc",
    "schema_version",
    "sequence",
    "source_kind",
    "summary"
  ],
  "properties": {
    "event_type": {
      "enum": [
        "QUEST_PROPOSED",
        "QUEST_APPROVED",
        "QUEST_REJECTED",
        "QUEST_PUBLISHED",
        "QUEST_ACCEPTED",
        "QUEST_DECLINED",
        "WORK_STARTED",
        "ARTIFACT_SUBMITTED",
        "REVIEW_PASSED",
        "REVIEW_FAILED",
        "QUEST_COMPLETED",
        "QUEST_FAILED",
        "OBSERVATION_RECORDED",
        "ANOMALY_DETECTED",
        "RUN_INTERRUPTED",
        "BUDGET_EXHAUSTED",
        "POLICY_DENIED",
        "AUDIT_UNAVAILABLE"
      ]
    },
    "payload": {
      "type": "object"
    },
    "correlation_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "producer_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "source_kind": {
      "enum": [
        "SIMULATED",
        "AGENT_REPORTED",
        "SYSTEM_OBSERVED",
        "OPERATOR_DECISION"
      ]
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "previous_hash",
        "event_hash"
      ],
      "properties": {
        "previous_hash": {
          "type": "string",
          "pattern": "^(GENESIS|[0-9a-f]{64})$"
        },
        "event_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "event_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "quest_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "causation_event_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "ingestion_policy_version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "actor_version": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "reason_declared": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 1000
    },
    "ledger_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "actor_kind": {
      "enum": [
        "AGENT",
        "OPERATOR",
        "SYSTEM"
      ]
    },
    "actor_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "schema_version": {
      "const": "sentinel-event/0.1"
    },
    "evidence_refs": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 240
      }
    },
    "recorded_at_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "occurred_at_utc": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "authorization_ref": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 240
    }
  },
