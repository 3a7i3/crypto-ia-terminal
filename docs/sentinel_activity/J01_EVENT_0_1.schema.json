                "type": "array",
                "minItems": 1,
                "maxItems": 16,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                }
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "acceptance_criteria": {
                "type": "array",
                "minItems": 1,
                "maxItems": 16,
